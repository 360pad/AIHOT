      "config": {
        "url": "https://www.ccgp.gov.cn/cggg/zygg/index.htm",
        "baseUrl": "https://www.ccgp.gov.cn/cggg/zygg/index.htm",
        "itemSelector": "ul.c_list_bid > li",
        "linkSelector": "a[href]",
        "titleSelector": "a[href]",
        "publishedAtRegex": "发布时间：\\s*(?:<em[^>]*>)?(\\d{4}-\\d{2}-\\d{2}(?:\\s+\\d{2}:\\d{2})?)",
        "allowUrlPrefixes": ["https://www.ccgp.gov.cn/cggg/zygg/"],
        "_aihot": { "initialBackfillLimit": 20 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": ["官方", "政府采购", "中央公告"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-ggzy-national-trading-notices",
